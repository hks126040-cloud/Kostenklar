# Domain & App URL (Domain is strictly read from NEXT_PUBLIC_SITE_URL)
NEXT_PUBLIC_SITE_URL=https://example.com

# Neon Serverless Postgres (EU / Frankfurt: eu-central-1)
DATABASE_URL=postgresql://neondb_owner:password@ep-something-pooler.c-8.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-something.c-8.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_BRANCH=production

# Lead Notifications (EU Resend or Brevo)
RESEND_API_KEY=re_123456789
LEAD_NOTIFICATION_EMAIL=leads@example.com

# Security & DSGVO
IP_HASH_SALT=your_custom_secret_salt_here

# Spam Protection (Cloudflare Turnstile - DSGVO-friendly alternative to reCAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...
