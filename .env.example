# Domain & App URL
NEXT_PUBLIC_SITE_URL=https://kostenklar.de

# Supabase (EU / Frankfurt: eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-expose

# Lead Notifications (EU Resend or Brevo)
RESEND_API_KEY=re_123456789
LEAD_NOTIFICATION_EMAIL=leads@kostenklar.de

# Spam Protection (Cloudflare Turnstile - DSGVO-friendly alternative to reCAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

